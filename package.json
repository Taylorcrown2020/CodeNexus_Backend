  "type": "commonjs",
  "description": "Diamondback Coding \u2014 backend, CRM, admin portal, customer portal, billing, email/SMS",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:setup": "node db.js",
    "build": "npx puppeteer browsers install chrome",
    "lint": "eslint . --ext .js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "db:migrate": "psql \"$DATABASE_URL\" -f migrations/001_customer_portal.sql && psql \"$DATABASE_URL\" -f migrations/002_billing_and_portal_kind.sql && psql \"$DATABASE_URL\" -f migrations/003_customer_first_and_maintenance.sql",
    "db:verify": "node db.js"
  },
